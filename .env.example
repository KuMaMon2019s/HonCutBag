# Honcut 项目 API Keys 配置
# 复制此文件为 .env 并填入你的 API keys

# ═══════════════════════════════════════════════════════════════════════════════
# 必需配置
# ═══════════════════════════════════════════════════════════════════════════════

# 火山方舟 Agent Plan API Key（主要使用）
# 获取地址: https://console.volcengine.com/ark/region:cn-beijing/apiKey
ARK_AGENT_API_KEY=your-api-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# 可选配置
# ═══════════════════════════════════════════════════════════════════════════════

# 火山方舟 Coding Plan API Key（Hermes 记忆系统使用）
# ARK_API_KEY=***

# OpenAI API Key（备选 LLM）
# OPENAI_API_KEY=sk-...

# 豆包语音 API Key（音频生成）
# DOUBAO_SPEECH_API_KEY=***

# ElevenLabs API Key（高级语音合成）
# ELEVENLABS_API_KEY=***

# fal.ai API Key（OpenMontage 工具使用）
# 获取地址: https://fal.ai/dashboard/keys
# FAL_KEY=***

# 视频模型提供方与传输路由是两个独立配置：
# VIDEO_PROVIDER 选择模型；VIDEO_GENERATION_MODE 选择 bridge/direct/local。
VIDEO_PROVIDER=seedance
# 默认通过 Bridge 调用 Seedance；改为 direct 才会直连 ARK Agent Plan。
VIDEO_GENERATION_MODE=bridge
# VIDEO_PROVIDER_SEEDANCE=bridge
# VIDEO_PROVIDER_WAN=bridge
# VIDEO_PROVIDER_KLING=direct
# BRIDGE_API_URL=***
# Bridge reports progress=100% before the video is downloadable; cap probing at 60s.
VIDEO_DOWNLOAD_PROBE_TIMEOUT=60

# Phase 5 分镜质检失败后的定向自动纠偏轮数（0=关闭，默认 2，最大 3）。
# 每轮只给失败镜头及其连续性依赖重绘，并在重新质检后决定是否进入 Phase 6。
HONCUT_PHASE5_MAX_CORRECTIONS=2

# 连续长镜头的本地接缝修复；默认关闭，不改变现有输出。
# auto 会先检测并硬裁下一片段开头重播的参考视频；插值只作切点证据，不进入成片。
HONCUT_CONTINUITY_MODE=auto
HONCUT_CONTINUITY_BRIDGE=off
HONCUT_CONTINUITY_BRIDGE_FRAMES=4,6,8
HONCUT_CONTINUITY_OVERLAP_SECONDS=2.0

# 可选：为 Phase 8 接缝器提供 SAM 3 主体轨迹证据。
# managed 由 Phase 8 按需启停本地服务；external 复用 HONCUT_SAM3_URL；off 关闭。
# HONCUT_SAM3_MODE=managed
# HONCUT_SAM3_URL=http://127.0.0.1:8001
# HONCUT_SAM3_ANALYSIS_FPS=3
# HONCUT_SAM3_REFINE_MIN_CORRELATION=0.55
# HONCUT_SAM3_STARTUP_TIMEOUT=30
# SAM3_CHECKPOINT=/absolute/path/to/sam3.pt
# SAM3_ASSET_ROOT=/Users/soda/projects/sam3
# SAM3_DEVICE=auto
# SAM3_PRECISION=auto
# SAM3_CPU_THREADS=6
# SAM3_MAX_FRAMES=96
# SAM3_CPU_BF16=0
